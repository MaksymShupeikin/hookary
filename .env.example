# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Local defaults point at the compose stack. Every CHANGE_ME value must be
# configured; only values explicitly described as secrets need secret storage.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
HOOKARY_ENV=dev
LOG_LEVEL=debug

# Values compiled into Flutter by the Makefile targets below. Only public
# configuration belongs here; backend secrets are never passed to Dart.
HOOKARY_API_BASE_URL=http://localhost:8080
# Docker nginx proxies this same-origin URL to api:8080. Keep the separate
# value because `make run-web` talks to the host-published API port directly.
HOOKARY_DOCKER_API_BASE_URL=http://localhost:8000
HOOKARY_PRODUCTION=false
HOOKARY_WEB_PORT=8000

# ---------------------------------------------------------------------------
# Service ports (host side)
# ---------------------------------------------------------------------------
API_ADDR=:8080
INGEST_HEALTH_ADDR=:8081
ANALYZE_HEALTH_ADDR=:8082
RENDER_HEALTH_ADDR=:8083
PUBLISH_HEALTH_ADDR=:8084

# Ingest downloads and probes on a disk-backed Docker volume, not RAM. Files
# are removed after every job. Limits apply equally to uploads and URL imports.
INGEST_MAX_MEDIA_BYTES=4294967296
INGEST_MAX_DURATION=4h
INGEST_METADATA_TIMEOUT=2m
INGEST_DOWNLOAD_TIMEOUT=90m
INGEST_PROBE_TIMEOUT=2m
INGEST_NORMALIZE_TIMEOUT=2h
INGEST_AUDIO_TIMEOUT=2h
INGEST_AUDIO_CHUNK_LENGTH=20m

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=hookary
POSTGRES_PASSWORD=hookary_local_dev
POSTGRES_DB=hookary
POSTGRES_PORT=5432

# Host-side URL, for goose and psql run from your machine.
# Services inside compose get the in-network host via compose.yaml.
DATABASE_URL=postgres://hookary:hookary_local_dev@localhost:5432/hookary?sslmode=disable

# The pool needs an explicit ceiling: five services sharing one Postgres will
# happily exhaust max_connections otherwise.
DATABASE_MAX_CONNS=10

# ---------------------------------------------------------------------------
# NATS JetStream
# ---------------------------------------------------------------------------
NATS_URL=nats://localhost:4222
NATS_PORT=4222
NATS_MONITORING_PORT=8222

# ---------------------------------------------------------------------------
# Object storage
#
# Local dev talks to MinIO; production talks to Cloudflare R2. Same S3 API, so
# only these values change between them.
#
# R2 production values:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_PUBLIC_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_BUCKET=hookary-media-prod
#   S3_FORCE_PATH_STYLE=false
#
# Presigned URLs must be issued against the R2 S3 API endpoint above, not a
# custom domain, or the signature will not validate.
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=hookary-media-dev
S3_ACCESS_KEY_ID=hookary_minio
S3_SECRET_ACCESS_KEY=hookary_minio_local_dev
S3_FORCE_PATH_STYLE=true

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# A presigned URL is a bearer token. Keep the window short and never log one.
S3_PRESIGN_TTL=15m

# ---------------------------------------------------------------------------
# Auth
#
# JWT_SECRET signs Hookary's own access tokens. Generate one per environment:
#   openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Google Sign-In. These are audiences we verify ID tokens against, one per
# platform, and they are not secrets.
#   Login scopes stay minimal: openid, email, profile.
#   YouTube upload is a separate grant — never widen these.
#   A web OAuth client secret is not used by this ID-token login flow.
GOOGLE_CLIENT_ID_WEB=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_ID_IOS=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=CHANGE_ME.apps.googleusercontent.com

# YouTube publishing grant (Stage 11). Distinct client from Sign-In above.
YOUTUBE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=CHANGE_ME
YOUTUBE_REDIRECT_URL=http://localhost:8080/v1/platforms/youtube/callback

# Encrypts platform refresh tokens at rest. 32 bytes, base64:
#   openssl rand -base64 32
PLATFORM_TOKEN_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32

# ---------------------------------------------------------------------------
# OpenAI
#
# Model snapshots are pinned here, never in code, so a model swap is a config
# change and the pin is recorded per job.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=CHANGE_ME
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_RANK_MODEL=gpt-5.4-nano-2026-03-17
OPENAI_SELECT_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_CLIP_PROMPT_VERSION=clip-selection-v2

# Hard stop for AI spend, in USD. On reach, new AI jobs fail with
# budget_exhausted instead of retrying.
OPENAI_BUDGET_LIMIT_USD=45
OPENAI_REQUEST_TIMEOUT=10m

# Vertical 1080x1920 rendering. Work files use the render-work Docker volume,
# not RAM, and are deleted after every job.
RENDER_TIMEOUT=2h
RENDER_MAX_SOURCE_BYTES=4294967296
RENDER_FFMPEG_THREADS=2
RENDER_MAX_CONCURRENT=1

# ---------------------------------------------------------------------------
# CORS
#
# Browser uploads go straight to S3/R2, so the bucket needs its own CORS rules
# matching these origins. Without them presigned PUTs fail in the browser.
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5000
